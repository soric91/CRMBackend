# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Local Docker overrides — machine-specific, never deployed
docker-compose.override.yml

# Working documents: integration guides and hand-offs between repos. They are
# written for a person to read once, not maintained as part of the codebase.
*PROMPT*.md
GATEWAY_INTEGRATION.html

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Índices derivados del código: se regeneran, y versionarlos genera conflictos
# en cada rama sin aportar nada que el código no diga ya.
.tokensave/
graphify-out/

# Permisos de Claude Code en esta máquina. Son de quien usa la terminal, no
# del proyecto.
.claude/settings.local.json

# Capturas pegadas al chat (Claude Code las guarda en el cwd del proyecto)
Imagen pegada*.png

# Signing keys. The private half must never be committed.
secrets/
*.pem
