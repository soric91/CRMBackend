# ----------------------------------------------------------------------------
# CRM Backend - environment contract
#
# Copy to `.env` and fill in with YOUR OWN real values.
# Never commit `.env`. Never put real credentials in this file.
#
# DO NOT QUOTE VALUES. python-dotenv strips surrounding quotes, but Docker's
# `--env-file` and Compose's `env_file` pass them through literally: a quoted
# password would reach PostgreSQL with the quotes attached and the connection
# would fail with an authentication error that says nothing about quoting.
# ----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=CRM Backend
API_V1_PREFIX=/api/v1
# local | development | staging | production
ENVIRONMENT=local
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins. Empty disables CORS.
CORS_ORIGINS=

# --- Database (Supabase / PostgreSQL) ----------------------------------------
# PostgreSQL DSN from your Supabase project. NOT the Project URL
# (`https://<ref>.supabase.co`) — that one is the PostgREST endpoint.
#   Dashboard > Connect > Connection String > Session pooler
# Session pooler (port 5432) is the right choice: Alembic emits DDL, which the
# transaction pooler (6543) cannot hold across a migration.
#
# Leave `[YOUR-PASSWORD]` out of the URL and put it in SUPABASE_DB_PASSWORD
# below: the app merges and escapes it, so special characters (@ / # % :) in
# the password cannot break the DSN.
# Format: postgresql://<user>@<host>:<port>/<database>
# The application rewrites the scheme to `postgresql+asyncpg://` at runtime.
#
# Do NOT use the "Direct connection" (`db.<ref>.supabase.co`): on recent
# Supabase projects it only publishes an AAAA record, so it is unreachable from
# an IPv4-only network. The pooler answers over IPv4.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# TLS mode for the database connection. Supabase requires encryption and
# asyncpg does not enable it by default.
#   require      encrypts, does not verify the server certificate
#   verify-full  also verifies it — preferred in production
DB_SSL_MODE=require

# Log every emitted SQL statement (noisy; local debugging only).
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- MQTT --------------------------------------------------------------------
# Notices to gateways and presence from them. The configuration itself never
# travels here: the gateway is told there is something new and fetches it over
# HTTP with its own credential.
#
# Leave disabled and everything still works — the gateway polls anyway.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
# Port 1883 sends the password in the clear. Use 8883 with TLS on anything
# reachable from the internet.
MQTT_TLS=true
# A namespace of its own, apart from the telemetry topics the gateways already
# publish readings on.
MQTT_TOPIC_PREFIX=crm/gateways

# --- Security (JWT) ----------------------------------------------------------
# HS256 signs and verifies with the same secret, so whoever can check a token
# can also mint one. That is fine while this API is the only consumer of its
# own tokens, and unacceptable the moment another service has to trust them.
#
# RS256 splits it: the private key signs here and never leaves; the public key
# only verifies and is published at /.well-known/jwks.json. Use RS256 as soon
# as ApiEMS starts accepting logins issued by this API.
#
#   HS256 | HS384 | HS512 | RS256 | RS384 | RS512
# Cifra los valores secretos de la configuración de plataforma —la contraseña
# del broker, el token de InfluxDB del servidor— que sí hay que poder leer de
# vuelta para servírselos a un gateway. Vive acá y no en la base a propósito:
# así un volcado de la base, solo, no alcanza para leerlos.
#
# Sin esta clave la API se niega a guardar un valor secreto, en vez de
# guardarlo en claro sin avisar. Si se pierde o se cambia, los secretos ya
# guardados dejan de descifrarse y hay que volver a cargarlos.
#
# Generar una con:
#   uv run python -c "from app.core.secret_box import generate_key; print(generate_key())"
SETTINGS_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256

# --- with HS* ---
# Minimum 32 characters. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- with RS* ---
# Paths to the PEM files, not the PEM itself: a PEM is multi-line, and Docker's
# --env-file passes quotes through literally instead of stripping them.
#
# Generate your own pair (the private key must never leave the server):
#   mkdir -p secrets && chmod 700 secrets
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out secrets/jwt-private.pem
#   openssl rsa -in secrets/jwt-private.pem -pubout -out secrets/jwt-public.pem
#   chmod 600 secrets/jwt-private.pem
#
# `secrets/` is gitignored. In Docker, mount it read-only:
#   volumes: [ "./secrets:/app/secrets:ro" ]
#
# Switching algorithm invalidates every token already issued: people log in
# again, and gateways renew by themselves on the first 401.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Life of the token a gateway gets in exchange for its credential. It renews
# the token by itself, so this is short on purpose.
GATEWAY_TOKEN_EXPIRE_HOURS=24

# Life of the token another system (ApiEMS) gets for its service credential.
# Revoking a service account cannot reach a token already minted, so this
# number is exactly how long a revocation takes to be felt. Keep it short.
SERVICE_TOKEN_EXPIRE_MINUTES=60
